{
  "providers": {
    "corp": {
      "baseUrl": "https://aiXIngerence.localnw.ae/v1",
      "auth": {
        "type": "apiKey"
      },
      "caCertPath": null
    }
  },
  "model": "corp:qwen3-27b",
  "smallFastModel": "corp:qwen3-7b",
  "autoCompact": true,
  "autoCompactThreshold": 0.8,
  "persistSessions": true,
  "cleanupPeriodDays": 30,
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(pytest:*)"
    ],
    "deny": [],
    "defaultMode": "default"
  },
  "rag": {
    "enabled": "auto",
    "embeddingModel": "corp:bge-m3",
    "store": {
      "type": "local"
    },
    "exclude": [
      "**/vendor/**"
    ],
    "autoContext": {
      "enabled": true,
      "topK": 5,
      "maxTokens": 2000
    }
  }
}
