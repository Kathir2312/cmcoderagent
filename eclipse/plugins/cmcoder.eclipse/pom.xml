<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>cmcoder.eclipse</groupId>
    <artifactId>cmcoder-eclipse-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>cmcoder.eclipse</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>eclipse-plugin</packaging>

  <build>
    <plugins>
      <!-- The shared chat panel (clients/web-panel, built with npm first) and its
           theme list and the brand icon go into panel/. The test driver stays out:
           the tests add it themselves. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>panel</id>
            <phase>generate-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.basedir}/panel</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${project.basedir}/../../../clients/web-panel/dist</directory>
                  <includes>
                    <include>chat.js</include>
                    <include>chat.css</include>
                    <include>navigator.js</include>
                    <include>navigator.css</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.basedir}/../../../clients/web-panel</directory>
                  <includes><include>theme.json</include></includes>
                </resource>
                <resource>
                  <directory>${project.basedir}/../../../branding</directory>
                  <includes><include>icon.png</include><include>brand.json</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- (maven-enforcer's requireFilesExist refuses paths with "..".) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>panel-built</id>
            <phase>validate</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <fail message="Build the shared chat panel first: cd clients/web-panel and run npm ci, then npm run build.">
                  <condition>
                    <not>
                      <and>
                        <available file="${project.basedir}/../../../clients/web-panel/dist/chat.js"/>
                        <available file="${project.basedir}/../../../clients/web-panel/dist/navigator.js"/>
                      </and>
                    </not>
                  </condition>
                </fail>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
