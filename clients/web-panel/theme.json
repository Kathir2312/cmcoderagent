{
  "about": "The colours and fonts the shared panel uses, as CSS variables on :root. VS Code sets them itself; the other IDEs (JetBrains, Visual Studio, Eclipse) set each one from their own theme, and set them again when the theme changes. 'dark' and 'light' are the values to use where an IDE has no matching colour (VS Code's Dark Modern and Light Modern). tests/theme.test.ts checks the panel uses exactly these.",
  "variables": {
    "--vscode-font-family": { "role": "UI font", "dark": "system-ui, \"Segoe UI\", sans-serif", "light": "system-ui, \"Segoe UI\", sans-serif" },
    "--vscode-font-size": { "role": "UI font size", "dark": "13px", "light": "13px" },
    "--vscode-editor-font-family": { "role": "Code font", "dark": "Consolas, \"JetBrains Mono\", monospace", "light": "Consolas, \"JetBrains Mono\", monospace" },
    "--vscode-editor-font-size": { "role": "Code font size", "dark": "13px", "light": "13px" },
    "--vscode-foreground": { "role": "Default text", "dark": "#cccccc", "light": "#3b3b3b" },
    "--vscode-descriptionForeground": { "role": "Secondary text (hints, details)", "dark": "#9d9d9d", "light": "#717171" },
    "--vscode-errorForeground": { "role": "Error text", "dark": "#f85149", "light": "#c72e0f" },
    "--vscode-editorWarning-foreground": { "role": "Warning text", "dark": "#cca700", "light": "#895503" },
    "--vscode-testing-iconPassed": { "role": "Success text and marks", "dark": "#73c991", "light": "#388a34" },
    "--vscode-textLink-foreground": { "role": "Links", "dark": "#4daafc", "light": "#005fb8" },
    "--vscode-textLink-activeForeground": { "role": "Links on hover", "dark": "#4daafc", "light": "#005fb8" },
    "--vscode-focusBorder": { "role": "Keyboard focus outline", "dark": "#0078d4", "light": "#005fb8" },
    "--vscode-sideBar-background": { "role": "Panel background", "dark": "#181818", "light": "#f8f8f8" },
    "--vscode-editor-background": { "role": "Background of the user's messages and the navigator", "dark": "#1f1f1f", "light": "#ffffff" },
    "--vscode-editorWidget-background": { "role": "Pop-up background (details)", "dark": "#202020", "light": "#f8f8f8" },
    "--vscode-panel-border": { "role": "Separators and borders", "dark": "#2b2b2b", "light": "#e5e5e5" },
    "--vscode-textCodeBlock-background": { "role": "Code background", "dark": "#2b2b2b", "light": "#f0f0f0" },
    "--vscode-progressBar-background": { "role": "Progress line accent (blue)", "dark": "#0078d4", "light": "#005fb8" },
    "--vscode-input-background": { "role": "Text box background", "dark": "#313131", "light": "#ffffff" },
    "--vscode-input-foreground": { "role": "Text box text", "dark": "#cccccc", "light": "#3b3b3b" },
    "--vscode-input-border": { "role": "Text box border", "dark": "#3c3c3c", "light": "#cecece" },
    "--vscode-button-background": { "role": "Main button", "dark": "#0078d4", "light": "#005fb8" },
    "--vscode-button-foreground": { "role": "Main button text", "dark": "#ffffff", "light": "#ffffff" },
    "--vscode-button-hoverBackground": { "role": "Main button on hover", "dark": "#026ec1", "light": "#0258a8" },
    "--vscode-button-secondaryBackground": { "role": "Other buttons", "dark": "#313131", "light": "#e5e5e5" },
    "--vscode-button-secondaryForeground": { "role": "Other buttons' text", "dark": "#cccccc", "light": "#3b3b3b" },
    "--vscode-button-secondaryHoverBackground": { "role": "Other buttons on hover", "dark": "#3c3c3c", "light": "#cccccc" },
    "--vscode-list-activeSelectionBackground": { "role": "Selected list item", "dark": "#04395e", "light": "#e8e8e8" },
    "--vscode-editorSuggestWidget-background": { "role": "Command list (/) background", "dark": "#202020", "light": "#f8f8f8" },
    "--vscode-editorSuggestWidget-border": { "role": "Command list border", "dark": "#454545", "light": "#c8c8c8" },
    "--vscode-editorSuggestWidget-selectedBackground": { "role": "Command list: selected", "dark": "#04395e", "light": "#e8e8e8" },
    "--vscode-editorSuggestWidget-selectedForeground": { "role": "Command list: selected text", "dark": "#ffffff", "light": "#000000" }
  }
}
