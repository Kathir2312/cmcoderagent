<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# core against the real cmcoder and the mock model server (as the
       JVM core's tests): CMCODER_TEST_PYTHON (a Python with cmcoder, for the
       mock server) and, on Windows, CMCODER_TEST_BINARY (the standalone
       cmcoder.exe). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- A test may use the core's internals. -->
    <RootNamespace>Cmcoder.Core.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- [SkippableFact]: a test skips (not fails) without its equipment; CI sets it all. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Cmcoder.Core/Cmcoder.Core.csproj" />
  </ItemGroup>
</Project>
